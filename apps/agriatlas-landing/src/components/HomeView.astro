---
import { t } from '../i18n/ui';
import { CONTACT_EMAIL, chatDisplayUrl, chatUrl, localePath, type DictKey, type Lang } from '../i18n/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const assistantHref = chatUrl(lang);
const assistantDisplay = chatDisplayUrl(lang);
const researchHref = localePath('/research', lang);

type Mode = 'soil_moisture' | 'et0' | 'gdd' | 'salinity' | 'frost' | 'leaf_wetness' | 'crop_stress';
/** The 7 virtual sensor indices — `field` is the technical identifier exposed by the API. */
const indices: { mode: Mode; field: string; name: DictKey; desc: DictKey }[] = [
  { mode: 'soil_moisture', field: 'soil_moisture_root_zone', name: 'indices.soil_moisture.name', desc: 'indices.soil_moisture.desc' },
  { mode: 'et0', field: 'et0_mm_day', name: 'indices.et0.name', desc: 'indices.et0.desc' },
  { mode: 'gdd', field: 'gdd_accumulated', name: 'indices.gdd.name', desc: 'indices.gdd.desc' },
  { mode: 'salinity', field: 'salinity_risk_index', name: 'indices.salinity.name', desc: 'indices.salinity.desc' },
  { mode: 'frost', field: 'frost_risk_index', name: 'indices.frost.name', desc: 'indices.frost.desc' },
  { mode: 'leaf_wetness', field: 'leaf_wetness_hours', name: 'indices.leaf_wetness.name', desc: 'indices.leaf_wetness.desc' },
  { mode: 'crop_stress', field: 'crop_stress_gravity_score', name: 'indices.crop_stress.name', desc: 'indices.crop_stress.desc' },
];

const regions: { id: 'mekong' | 'highlands' | 'red_river' | 'central_coast'; name: DictKey; desc: DictKey }[] = [
  { id: 'red_river', name: 'regions.red_river.name', desc: 'regions.red_river.desc' },
  { id: 'central_coast', name: 'regions.central_coast.name', desc: 'regions.central_coast.desc' },
  { id: 'highlands', name: 'regions.highlands.name', desc: 'regions.highlands.desc' },
  { id: 'mekong', name: 'regions.mekong.name', desc: 'regions.mekong.desc' },
];

/** Open data sources & open-science foundation models — proper names, not translated. */
const sources: { name: string; org: string }[] = [
  { name: 'Microsoft Aurora (v1.5 / 0.1° / Wave / Air Pollution)', org: 'Microsoft · MIT License · Nature 2025' },
  { name: 'NVIDIA Earth-2 (cBottle & FourCastNet 3)', org: 'NVIDIA · Apache-2.0' },
  { name: 'TerraMind-1.0-base & THOR-1.0-base', org: 'Earth-Observation Foundation · Apache-2.0' },
  { name: 'Planetary Computer STAC & Earth Engine', org: 'Microsoft & Google · Non-Commercial Research' },
  { name: 'Sentinel-1/2, NASA SMAP & MODIS LST', org: 'ESA Copernicus & NASA' },
  { name: 'ECMWF AIFS 2.0 (Cross-Validation)', org: 'ECMWF · CC-BY-4.0' },
];

const seasonNames = Object.fromEntries(
  (['season.flooded', 'season.seedling', 'season.growing', 'season.ripening', 'season.harvest'] as const).map((k) => [k, t(lang, k)]),
);
---

<!-- STAGE: living field from orbit (hero + how it works, one sticky canvas) -->
<section class="stage" data-stage aria-labelledby="hero-title">
  <div class="stage-sticky">
    <canvas class="field" data-field aria-hidden="true"></canvas>
    <div class="scrim" aria-hidden="true"></div>
    <div class="hud container">
      <div class="season" data-season data-names={JSON.stringify(seasonNames)}>
        <svg viewBox="0 0 44 44" aria-hidden="true">
          <circle cx="22" cy="22" r="18" fill="none" stroke="rgb(238 243 240 / 0.18)" stroke-width="2"></circle>
          <circle class="season-arc" cx="22" cy="22" r="18" fill="none" stroke="var(--gold)" stroke-width="2.4" pathLength="100" stroke-dasharray="100" stroke-dashoffset="68" transform="rotate(-90 22 22)"></circle>
          <circle class="season-dot" cx="22" cy="4" r="3" fill="var(--gold)" style="transform-origin: 22px 22px"></circle>
        </svg>
        <div>
          <span class="hud-label">{t(lang, 'season.label')}</span>
          <span class="hud-value" data-season-name>{t(lang, 'season.growing')}</span>
        </div>
      </div>
      <p class="hud-note">{t(lang, 'art.illustrative')}</p>
    </div>
  </div>

  <div class="panels">
    <div id="top" class="panel panel-hero container">
      <div class="hero-copy">
        <h1 id="hero-title">{t(lang, 'hero.display')}</h1>
        <p class="hero-lead">{t(lang, 'hero.title')}</p>
        <p class="hero-sub">{t(lang, 'hero.subtitle')}</p>
        <div class="ctas">
          <a class="btn btn-primary" href={assistantHref} rel="noopener">{t(lang, 'hero.cta_primary')} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={researchHref}>{t(lang, 'hero.cta_secondary')} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <p class="hero-disclaimer">{t(lang, 'hero.disclaimer')}</p>
      </div>
      <p class="lens-hint" aria-hidden="true"><span class="lens-ico"></span>{t(lang, 'hero.lens_hint')}</p>
    </div>

    <div id="how" class="panel container" data-step="1">
      <div class="step-copy">
        <h2>{t(lang, 'how.title')}</h2>
        <p class="step-lead">{t(lang, 'how.lead')}</p>
        <h3>{t(lang, 'how.step1.title')}</h3>
        <p>{t(lang, 'how.step1.body')}</p>
      </div>
    </div>
    <div class="panel container" data-step="2">
      <div class="step-copy">
        <h3 class="step-big">{t(lang, 'how.step2.title')}</h3>
        <p>{t(lang, 'how.step2.body')}</p>
      </div>
    </div>
    <div class="panel container" data-step="3">
      <div class="step-copy">
        <h3 class="step-big">{t(lang, 'how.step3.title')}</h3>
        <p>{t(lang, 'how.step3.body')}</p>
        <p class="lights" aria-hidden="true"><i style="--c: var(--emerald)"></i><i style="--c: var(--amber)"></i><i style="--c: var(--red)"></i></p>
      </div>
    </div>
  </div>
</section>

<!-- LAB: seven indices as seven lenses on the same field -->
<section id="indices" class="lab" aria-labelledby="indices-title">
  <div class="container lab-grid">
    <div class="lab-text">
      <h2 id="indices-title" class="reveal">{t(lang, 'indices.title')}</h2>
      <p class="lab-lead reveal">{t(lang, 'indices.lead')} {t(lang, 'indices.pick')}</p>
      <ul class="index-list" role="list">
        {
          indices.map((i, n) => (
            <li>
              <button type="button" class="index-btn" data-mode={i.mode} aria-pressed={n === 0 ? 'true' : 'false'}>
                <span class="i-name">{t(lang, i.name)}</span>
                <span class="i-desc">{t(lang, i.desc)}</span>
                <code class="i-field">{i.field}</code>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="lab-view">
      <div class="lab-frame">
        <canvas data-lab aria-hidden="true"></canvas>
        <span class="lab-mode" data-lab-name>{t(lang, 'indices.soil_moisture.name')}</span>
      </div>
      <div class="legend">
        <span>{t(lang, 'legend.low')}</span>
        <span class="legend-bar" data-legend-bar></span>
        <span>{t(lang, 'legend.high')}</span>
      </div>
      <p class="note">{t(lang, 'art.illustrative')}</p>
    </div>
  </div>
</section>

<!-- REGIONS: four postcards from orbit -->
<section id="regions" class="regions" aria-labelledby="regions-title">
  <div class="container regions-head">
    <h2 id="regions-title" class="reveal">{t(lang, 'regions.title')}</h2>
    <p class="reveal">{t(lang, 'regions.lead')}</p>
  </div>
  <ul class="postcards container" role="list">
    {
      regions.map((r) => (
        <li class="postcard reveal">
          <canvas data-region={r.id} aria-hidden="true"></canvas>
          <div class="pc-text">
            <h3>{t(lang, r.name)}</h3>
            <p>{t(lang, r.desc)}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<!-- DATA -->
<section id="data" class="sources" aria-labelledby="data-title">
  <div class="container sources-grid">
    <div class="sources-head">
      <h2 id="data-title" class="reveal">{t(lang, 'data.title')}</h2>
      <p class="reveal">{t(lang, 'data.license_note')}</p>
    </div>
    <ul class="source-list" role="list">
      {sources.map((s) => <li class="reveal"><span class="s-name">{s.name}</span><span class="s-org">{s.org}</span></li>)}
    </ul>
  </div>
</section>

<!-- FINALE: surfaces + call to action -->
<section id="cta" class="finale" aria-labelledby="cta-title">
  <div class="container finale-grid">
    <div class="finale-copy">
      <h2 id="cta-title" class="reveal">{t(lang, 'cta.title')}</h2>
      <p class="reveal">{t(lang, 'cta.body')}</p>
      <div class="ctas reveal">
        <a class="btn btn-primary" href={assistantHref} rel="noopener">{t(lang, 'cta.primary')} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={`mailto:${CONTACT_EMAIL}`}>{t(lang, 'cta.partner')}</a>
      </div>
    </div>
    <div class="surfaces">
      <h3 class="surfaces-title">{t(lang, 'surfaces.title')}</h3>
      <a class="surface surface-live reveal" href={assistantHref} rel="noopener">
        <span class="chip chip-sample">{t(lang, 'surfaces.web.status')}</span>
        <span class="s-title">{t(lang, 'surfaces.web.name')}</span>
        <span class="s-desc">{t(lang, 'surfaces.web.desc')}</span>
        <span class="s-url">{assistantDisplay} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
      <div class="surface reveal">
        <span class="chip chip-dev">{t(lang, 'surfaces.mobile.status')}</span>
        <span class="s-title">{t(lang, 'surfaces.mobile.name')}</span>
        <span class="s-desc">{t(lang, 'surfaces.mobile.desc')}</span>
        <span class="lights" aria-hidden="true"><i style="--c: var(--emerald)"></i><i style="--c: var(--amber)"></i><i style="--c: var(--red)"></i></span>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    sharedScene, renderField, renderRegion, seasonKey, smoothstep, MODE_CSS_GRADIENT,
    type Mode, type RegionPreset,
  } from '../lib/landscape';

  document.documentElement.classList.add('js');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DPR = () => Math.min(window.devicePixelRatio || 1, 1.5);
  const scene = sharedScene();

  /* ---------------- stage: hero + how ---------------- */
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const sticky = stage.querySelector<HTMLElement>('.stage-sticky')!;
  const field = stage.querySelector<HTMLCanvasElement>('[data-field]')!;
  const seasonEl = stage.querySelector<HTMLElement>('[data-season]')!;
  const seasonName = stage.querySelector<HTMLElement>('[data-season-name]')!;
  const arc = stage.querySelector<SVGCircleElement>('.season-arc')!;
  const dot = stage.querySelector<SVGCircleElement>('.season-dot')!;
  const names = JSON.parse(seasonEl.dataset.names || '{}') as Record<string, string>;

  let season = 0.3;
  let pointer: { x: number; y: number; at: number } | null = null;
  const lens = { x: 0, y: 0, init: false };
  let visible = true, raf = 0, last = performance.now(), lastKey = '';

  window.addEventListener('pointermove', (e) => {
    const r = sticky.getBoundingClientRect();
    if (e.clientY < r.top || e.clientY > r.bottom) return;
    pointer = { x: e.clientX - r.left, y: e.clientY - r.top, at: performance.now() };
    if (reduce) schedule();
  }, { passive: true });

  function progress() {
    const r = stage.getBoundingClientRect();
    return Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
  }

  function frame(now: number) {
    raf = 0;
    const dt = Math.min(64, now - last); last = now;
    const w = sticky.clientWidth, h = sticky.clientHeight;
    const p = progress();
    if (!reduce) season = (season + dt / 52000) % 1;

    const live = pointer && now - pointer.at < 3500;
    const tx = live ? pointer!.x : w * (w < 768 ? 0.62 + 0.12 * Math.sin(now / 5600) : 0.66 + 0.16 * Math.sin(now / 5600));
    const ty = live ? pointer!.y : h * (w < 768 ? 0.3 + 0.06 * Math.sin(now / 4100 + 1.3) : 0.42 + 0.18 * Math.sin(now / 4100 + 1.3));
    if (!lens.init || reduce) { lens.x = tx; lens.y = ty; lens.init = true; }
    else { lens.x += (tx - lens.x) * 0.12; lens.y += (ty - lens.y) * 0.12; }

    renderField(field, scene, { w, h, dpr: DPR() }, {
      season,
      hexAlpha: smoothstep(0.16, 0.3, p) * (1 - 0.5 * smoothstep(0.78, 0.92, p)),
      swath: p > 0.4 && p < 0.8 ? (p - 0.4) / 0.4 : null,
      traffic: smoothstep(0.74, 0.88, p),
      lens: { x: lens.x, y: lens.y, r: Math.max(90, Math.min(w, h) * 0.16), alpha: 1 - smoothstep(0.1, 0.2, p), mode: 'soil_moisture' },
    });

    arc.style.strokeDashoffset = String(100 - season * 100);
    dot.style.transform = `rotate(${season * 360}deg)`;
    const k = seasonKey(season);
    if (k !== lastKey) { seasonName.textContent = names[k] ?? ''; lastKey = k; }

    if (visible && !reduce) raf = requestAnimationFrame(frame);
  }
  function schedule() { if (!raf) raf = requestAnimationFrame(frame); }

  new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; if (visible) schedule(); }).observe(stage);
  addEventListener('scroll', () => { if (reduce && visible) schedule(); }, { passive: true });
  addEventListener('resize', schedule);
  schedule();

  /* ---------------- lab: seven lenses ---------------- */
  const lab = document.querySelector<HTMLCanvasElement>('[data-lab]')!;
  const labName = document.querySelector<HTMLElement>('[data-lab-name]')!;
  const bar = document.querySelector<HTMLElement>('[data-legend-bar]')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.index-btn')];
  let mode: Mode = 'soil_moisture', modeAlpha = 1, labRaf = 0;

  function drawLab() {
    labRaf = 0;
    const box = lab.parentElement!;
    renderField(lab, scene, { w: box.clientWidth, h: box.clientHeight, dpr: DPR(), zoom: 1.35, focusX: 0.55, focusY: 0.5 }, {
      season: 0.42, hexAlpha: 0.2, mode, modeAlpha,
    });
    if (modeAlpha < 1) { modeAlpha = Math.min(1, modeAlpha + (reduce ? 1 : 0.08)); labRaf = requestAnimationFrame(drawLab); }
  }
  function setMode(m: Mode, btn: HTMLButtonElement) {
    mode = m; modeAlpha = 0.15;
    buttons.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
    labName.textContent = btn.querySelector('.i-name')?.textContent ?? '';
    bar.style.background = MODE_CSS_GRADIENT(m);
    if (!labRaf) labRaf = requestAnimationFrame(drawLab);
  }
  buttons.forEach((b) => {
    const go = () => setMode(b.dataset.mode as Mode, b);
    b.addEventListener('click', go);
    b.addEventListener('mouseenter', go);
    b.addEventListener('focus', go);
  });
  bar.style.background = MODE_CSS_GRADIENT(mode);

  /* ---------------- regions: postcards (render when visible) ---------------- */
  const cards = [...document.querySelectorAll<HTMLCanvasElement>('[data-region]')];
  const drawn = new WeakSet<HTMLCanvasElement>();
  const drawCard = (c: HTMLCanvasElement) => {
    renderRegion(c, c.dataset.region as RegionPreset, { w: c.clientWidth, h: c.clientHeight, dpr: DPR() });
    drawn.add(c);
  };
  const lazy = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting && e.target instanceof HTMLCanvasElement && !drawn.has(e.target)) drawCard(e.target);
    }
  }, { rootMargin: '300px' });
  cards.forEach((c) => lazy.observe(c));
  new IntersectionObserver(([e]) => { if (e?.isIntersecting && !labRaf) labRaf = requestAnimationFrame(drawLab); }, { rootMargin: '300px' }).observe(lab);

  let rt = 0;
  addEventListener('resize', () => {
    clearTimeout(rt);
    rt = window.setTimeout(() => { cards.filter((c) => drawn.has(c)).forEach(drawCard); if (!labRaf) labRaf = requestAnimationFrame(drawLab); }, 200);
  });

  /* ---------------- reveal on scroll ---------------- */
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>

<style>
  /* ---------- stage ---------- */
  .stage { position: relative; }
  .stage-sticky { position: sticky; top: 0; height: 100dvh; overflow: hidden; background: #3B4A33; }
  .field { position: absolute; inset: 0; width: 100%; height: 100%; }
  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(7 10 14 / 0.7) 0%, rgb(7 10 14 / 0) 22%),
      linear-gradient(0deg, rgb(7 10 14 / 0.85) 0%, rgb(7 10 14 / 0) 46%),
      linear-gradient(90deg, rgb(7 10 14 / 0.55) 0%, rgb(7 10 14 / 0) 55%);
  }
  .hud {
    position: absolute;
    bottom: 32px;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    pointer-events: none;
  }
  .season { display: flex; align-items: center; gap: 12px; }
  .season svg { width: 44px; height: 44px; }
  .season div { display: grid; line-height: 1.25; }
  .hud-label { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; color: var(--text-3); }
  .hud-value { font-family: var(--display); font-stretch: 90%; font-weight: 600; font-size: 20px; color: var(--text); }
  .hud-note { max-width: 34ch; text-align: right; font-family: var(--mono); font-size: 12px; line-height: 1.5; color: var(--text-3); }

  .panels { position: relative; margin-top: -100dvh; }
  .panel { min-height: 100dvh; display: flex; flex-direction: column; justify-content: flex-end; padding-block: 120px 72px; pointer-events: none; }
  .panel :is(a, button) { pointer-events: auto; }
  .panel-hero { justify-content: flex-end; }
  .hero-copy { max-width: 1100px; display: grid; gap: 22px; }
  .hero-copy h1 { font-size: var(--fs-mega); font-weight: 700; font-stretch: 78%; line-height: 1; letter-spacing: -0.02em; text-shadow: 0 2px 30px rgb(7 10 14 / 0.35); }
  .hero-lead { max-width: 30ch; font-size: var(--fs-l); font-family: var(--display); font-stretch: 92%; font-weight: 500; line-height: 1.18; color: var(--text); }
  .hero-sub { max-width: 58ch; color: var(--text-2); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .hero-disclaimer { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text-2); }
  .hero-disclaimer::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }
  .lens-hint { display: none; align-items: center; gap: 10px; margin-top: 36px; font-family: var(--mono); font-size: 12px; color: var(--text-3); }
  .lens-ico { width: 18px; height: 18px; border: 1.5px solid var(--cyan); border-radius: 50%; box-shadow: inset 0 0 0 4px rgb(0 240 255 / 0.18); }
  @media (hover: hover) { .lens-hint { display: inline-flex; } }

  .step-copy { max-width: 640px; display: grid; gap: 16px; padding: 28px 0; }
  .step-copy h2 { font-size: var(--fs-xl); }
  .step-lead { font-size: var(--fs-m); color: var(--text); max-width: 46ch; }
  .step-copy h3 { margin-top: 18px; font-size: var(--fs-l); font-weight: 600; font-stretch: 88%; color: var(--cyan); }
  .step-copy .step-big { margin-top: 0; font-size: var(--fs-xl); color: var(--text); }
  .step-copy p { color: var(--text-2); max-width: 52ch; }
  .lights { display: flex; gap: 10px; }
  .lights i { width: 18px; height: 18px; border-radius: 50%; background: var(--c); }

  /* ---------- lab ---------- */
  .lab { padding-block: clamp(96px, 12vw, 180px); }
  .lab-grid { display: grid; gap: 48px; }
  .lab-text h2 { font-size: var(--fs-xl); max-width: 14ch; }
  .lab-lead { margin-top: 20px; max-width: 48ch; color: var(--text-2); }
  .index-list { margin-top: 40px; border-top: 1px solid var(--line); }
  .index-btn {
    display: grid;
    gap: 6px;
    width: 100%;
    padding: 20px 0 20px 0;
    text-align: left;
    font: inherit;
    color: var(--text-2);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
    transition: color 240ms var(--ease), padding 360ms var(--ease);
  }
  .i-name { font-family: var(--display); font-size: var(--fs-l); font-weight: 600; font-stretch: 86%; line-height: 1.1; color: var(--text-3); transition: color 240ms var(--ease); }
  .i-desc { font-size: 15px; max-width: 46ch; }
  .i-field { font-size: 12.5px; color: var(--text-3); }
  .index-btn:hover .i-name, .index-btn[aria-pressed='true'] .i-name { color: var(--text); }
  .index-btn[aria-pressed='true'] { padding-left: 20px; box-shadow: inset 2px 0 0 var(--cyan); }
  .index-btn[aria-pressed='true'] .i-field { color: var(--cyan); }
  .lab-view { position: relative; }
  .lab-frame { position: relative; aspect-ratio: 4 / 5; border-radius: 6px; overflow: hidden; background: #3B4A33; }
  .lab-frame canvas { width: 100%; height: 100%; }
  .lab-mode {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 8px 14px;
    font-family: var(--display);
    font-size: 20px;
    font-weight: 600;
    font-stretch: 88%;
    color: var(--text);
    background: rgb(7 10 14 / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 6px;
  }
  .legend { display: flex; align-items: center; gap: 12px; margin-top: 16px; font-family: var(--mono); font-size: 12px; color: var(--text-3); }
  .legend-bar { flex: 1; height: 8px; border-radius: 4px; }
  .note { margin-top: 10px; font-family: var(--mono); font-size: 12px; color: var(--text-3); }
  @media (min-width: 1024px) {
    .lab-grid { grid-template-columns: 5fr 6fr; gap: 72px; align-items: start; }
    .lab-view { position: sticky; top: 96px; }
